output "name" {
  description = "Name of the backend service"
  value       = google_compute_backend_service.this.name
}

output "id" {
  description = "ID of the backend service"
  value       = google_compute_backend_service.this.id
}

output "self_link" {
  description = "Self link of the backend service"
  value       = google_compute_backend_service.this.self_link
}

output "fingerprint" {
  description = "Fingerprint of the backend service (for conditional updates)"
  value       = google_compute_backend_service.this.fingerprint
}

output "creation_timestamp" {
  description = "Creation timestamp of the backend service"
  value       = google_compute_backend_service.this.creation_timestamp
}

output "generated_id" {
  description = "Unique identifier generated by the server"
  value       = google_compute_backend_service.this.generated_id
}
